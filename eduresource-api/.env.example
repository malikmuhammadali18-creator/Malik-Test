# Backend environment variables for EduResource API
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eduresource
JWT_SECRET=super-secret-jwt-key
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Storage configuration
USE_LOCAL_STORAGE=true
S3_BUCKET=eduresource-bucket
S3_KEY=default-key
S3_SECRET=default-secret
S3_REGION=us-east-1

# Twilio SMS configuration (optional; required for broadcast SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
